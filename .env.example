# Copie este arquivo para .env.local (uso local) e configure as mesmas
# variáveis no painel do Vercel (Settings → Environment Variables) para produção.

# --- WhatsApp ---
# Número no formato internacional, só dígitos: código do país + DDD + número.
# Ex.: 55 11 91234-5678 -> 5511912345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://catalogo-compass.vercel.app

# --- Sincronização (rota /api/sync) ---
# Gere uma string aleatória qualquer e use o mesmo valor no cabeçalho
# "Authorization: Bearer <valor>" ao chamar a rota manualmente.
SYNC_SECRET=

# --- Fornecedor: XBZ Brindes ---
# Preencher assim que a XBZ enviar a documentação/credenciais da API de revenda.
XBZ_API_BASE_URL=
XBZ_API_TOKEN=

# --- Fornecedor: Asia Import ---
# Preencher assim que a Asia Import liberar acesso de API para a conta de revenda.
ASIA_API_BASE_URL=
ASIA_API_TOKEN=

# --- Fornecedor: Spot Gifts ---
# Preencher após aprovação do cadastro de revendedor na Spot.
SPOT_API_BASE_URL=
SPOT_API_TOKEN=
